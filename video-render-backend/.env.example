# Environment variables
NODE_ENV=development
PORT=3001

# Frontend URLs - ใช้แทน hardcode ใน code
FRONTEND_URL=http://localhost:3000
DEV_URL_1=http://localhost:5173
DEV_URL_2=http://localhost:5174

# Production URLs (ตั้งค่าตอน deploy)
# FRONTEND_URL=https://your-domain.com
# DEV_URL_1=https://your-domain.com
# DEV_URL_2=https://your-domain.com

# Redis configuration (optional, for job queue)
REDIS_URL=redis://localhost:6379

# File storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Video rendering settings
MAX_CONCURRENT_RENDERS=2
RENDER_TIMEOUT=300000

# CORS settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Remotion settings
REMOTION_CONCURRENCY=1
REMOTION_QUALITY=70
REMOTION_CRF=18
