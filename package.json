{
  "name": "render-with-copilot",
  "version": "1.0.0",
  "description": "Video rendering system with React video editor and Node.js backend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd video-render-backend && npm run dev",
    "dev:frontend": "cd AI-avatar-frontend/react-video-editor-main && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd video-render-backend && npm run build",
    "build:frontend": "cd AI-avatar-frontend/react-video-editor-main && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd video-render-backend && npm start",
    "start:frontend": "cd AI-avatar-frontend/react-video-editor-main && npm run preview",
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd video-render-backend && npm install",
    "install:frontend": "cd AI-avatar-frontend/react-video-editor-main && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "keywords": [
    "video",
    "rendering",
    "react",
    "nodejs",
    "ffmpeg",
    "remotion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.10.0"
  }
}
